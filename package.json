{
  "name": "red-green-open-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "test": "vitest run",
    "e2e": "playwright test",
    "shots:channels": "node scripts/shots-channels.mjs",
    "shots:ui1080": "node scripts/shots-ui-1080.mjs",
    "shots:skydive": "node scripts/shots-skydive.mjs",
    "shots:characters": "node scripts/shots-characters.mjs",
    "boot:requests": "node scripts/boot-requests.mjs",
    "shots:ui": "RG_SHOTS=1 playwright test tests/e2e/ui.spec.ts tests/e2e/chests.spec.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
